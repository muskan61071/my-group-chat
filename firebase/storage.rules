rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to verify authentication
    function signedIn() {
      return request.auth != null;
    }

    // Helper function to verify file size under 25MB
    function isValidSize() {
      return request.resource.size < 25 * 1024 * 1024;
    }

    // Allowed file types: images, audio, video, documents
    function isValidMediaType() {
      return request.resource.contentType.matches('(image|video|audio)/.*|application/(pdf|zip|msword|vnd\\..*)');
    }

    // User profile avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId && isValidSize() && request.resource.contentType.matches('image/.*');
    }

    // Group media uploads (attachments, voice notes, banners)
    match /groups/{groupId}/{allPaths=**} {
      allow read: if signedIn() && firestore.exists(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid));
      allow write: if signedIn() && 
        firestore.exists(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)) && 
        isValidSize() && 
        isValidMediaType();
    }
  }
}